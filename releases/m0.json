  "exclusions": [
    {
      "termEn": "Line",
      "reason": "Line＝線形是 Area 的一種範圍形狀，**本身是有效術語**，只是 M0 的 28 個條目都還沒用到；之後的招式會用到。目前掃到的 4 處全為假命中：3 處是 `line of effect`（＝效果線，另有 approved 條目 term.line-of-effect），1 處是「in a straight line」的日常用法。",
      "checkedAt": "2026-07-29"
    }
  ],
  "occurrenceExclusions": [
    {
      "termId": "term.magic.skill",
      "entityIds": [
        "ability.censor.halt-miscreant",
        "ability.censor.your-allies-cannot-save-you"
      ],
      "reason": "這兩處是 flavor 的「holy magic」與「your magic strike」，magic 作普通名詞用，既不是技能名稱也不是招式關鍵詞。真正用到技能名的只有 feature.censor.censor-order 的「You have the Magic skill.」。",
      "checkedAt": "2026-07-29"
    }
